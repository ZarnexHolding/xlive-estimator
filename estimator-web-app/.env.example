# Copy to .env.local and fill in. Never commit .env.local or real keys.

# --- Supabase (connected mode). Leave empty to run in browser-only demo mode. ---
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (sb_publishable_...) or the legacy anon key; safe in the browser (RLS applies).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. Presented to the database when recording approvals, quotations and AI analysis
# results, and to the background analysis function; the database stores only its SHA-256 hash in
# private.server_keys (see README "Server key").
ESTIMATOR_SERVER_KEY=

# --- AI document analysis (server-side only) ---------------------------------
# Leave empty to run without AI: the app then says "AI analysis not configured"
# and never substitutes mock results.
ANTHROPIC_API_KEY=
# Optional model override (default: claude-opus-5-5)
ANTHROPIC_MODEL=
# Demo mode only (no Supabase, so no sign-in): in production the paid /api/analyse endpoint is
# disabled unless this is "true". Ignored in connected mode, where sign-in is required.
ALLOW_UNAUTHENTICATED_ANALYSIS=false

# --- Backups: for `npm run backup` on your computer. Never add these to Netlify. ---
# Session pooler connection string from Supabase (Connect button), with the database password in it.
SUPABASE_DB_URL=
# Secret key (sb_secret_...) from Supabase: Project Settings, API Keys. Reads the private PDFs.
SUPABASE_SECRET_KEY=
# Where backups are written. Must be outside this repository (default: ../../estimator-backups).
BACKUP_DIR=
